---
import Layout from '../layouts/Layout.astro';
import { BriefcaseBusiness, Building2, ClipboardCheck, HardHat, Lock, ShieldCheck, Truck, Umbrella } from '@lucide/astro';

const coverages = [
  { icon: ShieldCheck, title: 'General Liability', desc: 'Protection against third-party claims of bodily injury, property damage, and personal injury arising from your business operations.' },
  { icon: Building2, title: 'Commercial Property', desc: 'Covers your building, equipment, inventory, and other business property from fire, theft, vandalism, and covered weather events.' },
  { icon: Truck, title: 'Commercial Auto', desc: 'Coverage for company vehicles used in your business — from a single work truck to a full fleet.' },
  { icon: Umbrella, title: 'Commercial Umbrella', desc: 'Extra liability limits above your underlying policies. Essential for businesses with significant exposure.' },
  { icon: HardHat, title: 'Workers\' Compensation', desc: 'Required in Utah for most employers. Covers medical costs and lost wages for employees injured on the job.' },
  { icon: BriefcaseBusiness, title: 'Professional Liability', desc: 'Also known as E&O insurance. Protects professionals from claims of negligence, errors, or omissions in the services they provide.' },
  { icon: ClipboardCheck, title: 'Surety Bonds', desc: 'License bonds, contract bonds, and court bonds for contractors, professionals, and businesses requiring bonding.' },
  { icon: Lock, title: 'Cyber Liability', desc: 'Covers your business from data breaches, ransomware attacks, and cyber incidents that can disrupt operations and expose sensitive data.' },
];
---
<Layout
  title="Business Insurance"
  description="Business insurance in Bountiful, Utah. B&A Insurance Producers offers general liability, commercial property, workers comp, professional liability, bonds, and more. Call (801) 487-2300."
>
  <section class="bg-[#016490] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[#7ebee7] font-semibold text-sm uppercase tracking-widest mb-3">Business Protection</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Business Insurance<br /><span class="text-[#7ebee7]">Safeguarding What You've Built</span></h1>
      <p class="text-white/80 text-xl max-w-2xl leading-relaxed mb-8">We offer tailored business insurance packages to meet your ever-changing needs, including access to specialty markets for hard-to-place risks.</p>
      <a href="/contact-us/" class="inline-block px-8 py-4 bg-white text-[#016490] font-bold rounded-lg hover:bg-[#f4f8fb] transition-colors shadow-lg">Get a Business Quote</a>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold text-slate-900">Business Coverage Options</h2>
        <p class="mt-3 text-slate-500 max-w-xl mx-auto">From startups to established operations, we build customized coverage packages that protect your business on every front.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {coverages.map(({ icon: Icon, title, desc }) => (
          <div class="bg-[#f4f8fb] rounded-2xl p-6 border border-slate-100 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-white border border-slate-100 flex items-center justify-center mb-4 text-[#016490]">
              <Icon class="w-7 h-7" aria-hidden="true" />
            </div>
            <h3 class="font-bold text-slate-900 mb-2">{title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#f4f8fb]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#016490] rounded-3xl p-10 lg:p-16 text-white">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="text-3xl font-bold mb-4">We Represent You — Not the Carrier</h2>
            <p class="text-white/80 leading-relaxed mb-4">Many business owners aren't fully aware of the gaps in their coverage until a claim is filed. Our role is to proactively identify those gaps, compare options across our carrier network, and make sure your policy actually matches your risk.</p>
            <p class="text-white/80 leading-relaxed">We also have access to specialty and surplus lines markets for businesses that are harder to place with standard carriers.</p>
          </div>
          <div class="space-y-4">
            {['General contractors', 'Retail &amp; restaurants', 'Professional services', 'Trucking &amp; transportation', 'Construction', 'Healthcare &amp; medical offices', 'Non-profits &amp; associations', 'Hard-to-place risks'].map((item) => (
              <div class="flex items-center gap-3 text-white/90">
                <svg class="w-5 h-5 text-[#7ebee7] shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span set:html={item}/>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 text-center mb-10">Business Insurance FAQs</h2>
      <div class="space-y-4">
        {[
          { q: 'What\'s the minimum insurance a Utah business needs?', a: 'Most Utah businesses with employees are required to carry workers\' compensation. Beyond that, your lender, landlord, or contracts may require general liability. We help you identify what\'s required and what\'s recommended for your specific industry.' },
          { q: 'What does a BOP (Business Owner\'s Policy) include?', a: 'A BOP bundles general liability and commercial property into a single, usually discounted policy. It\'s ideal for small to mid-sized businesses. We\'ll assess whether a BOP or individual policies make more sense for your situation.' },
          { q: 'Do I need professional liability if I have general liability?', a: 'Yes — general liability covers physical risks, while professional liability (E&O) covers claims of negligence in your services or advice. Both are needed for most professional service providers.' },
        ].map(({ q, a }) => (
          <details class="bg-[#f4f8fb] rounded-xl border border-slate-100 shadow-sm group">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer font-semibold text-slate-900 list-none">
              {q}
              <svg class="w-5 h-5 text-[#016490] shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="px-6 pb-5 text-slate-600 leading-relaxed border-t border-slate-50 pt-4">{a}</p>
          </details>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/contact-us/" class="px-10 py-4 bg-[#016490] hover:bg-[#014d6e] text-white font-bold rounded-lg transition-colors shadow">Get a Business Quote</a>
      </div>
    </div>
  </section>

  <!-- Carriers -->
  <section class="py-14 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold text-slate-400 uppercase tracking-widest mb-8">Carriers We Work With</p>
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12">
        <img src="/images/carriers/liberty-mutual.png" alt="Liberty Mutual" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/travelers.png" alt="Travelers" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/nationwide.png" alt="Nationwide" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/chubb.png" alt="Chubb" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/hiscox.avif" alt="Hiscox" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/markel2.webp" alt="Markel" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/amig.avif" alt="AMIG" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
      </div>
    </div>
  </section>
</Layout>
