---
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: 'Sharie',
    role: 'Owner & Health Insurance Specialist',
    bio: 'Sharie has spent the last 28 years as the Principal Life/Health Broker — first working alongside her father Dennis for 10 years, then purchasing Bowthorpe & Associates in 2005 alongside her spouse George. Her deep expertise in health, life, and Medicare products has helped thousands of Utah families navigate their coverage options with confidence.',
    specialty: 'Health, Life & Medicare',
    initial: 'S',
  },
  {
    name: 'George',
    role: 'Owner & Managing Agent',
    bio: 'George spent 15 years working in marketing and advertising across the Salt Lake City area before purchasing Bowthorpe & Associates with his spouse Sharie in 2005. As the agency\'s managing principal, George oversees day-to-day operations while ensuring every client receives the personal, honest service that has defined this agency for over 40 years.',
    specialty: 'Agency Management & Personal Lines',
    initial: 'G',
  },
  {
    name: 'Ryan',
    role: 'Sales Director',
    bio: 'Ryan is a Brigham Young University graduate with a degree in Chinese. His exceptional communication skills and years of direct sales experience and training make him a trusted resource for clients exploring their coverage options. Ryan brings energy, thoroughness, and a genuine commitment to finding the right solution for each client.',
    specialty: 'Sales & New Business',
    initial: 'R',
  },
  {
    name: 'Jeff',
    role: 'Marketing Director',
    bio: 'Jeff brings over 5 years of product development management experience from the consumer goods industry. He currently operates Emerald Beacon, the marketing agency B&A has partnered with to grow its reach and better serve Utah communities. Jeff ensures that our message — honest, independent, local — reaches the people who need it most.',
    specialty: 'Marketing & Brand Strategy',
    initial: 'J',
  },
  {
    name: 'May',
    role: 'CSR & Licensed Agent',
    bio: 'With over 25 years at Bowthorpe & Associates, May is the institutional knowledge and steady hand behind our client service operation. She handles personal and commercial insurance renewals, endorsements, and new business with a level of care and attention to detail that clients have come to rely on for decades.',
    specialty: 'Personal & Commercial Lines',
    initial: 'M',
  },
  {
    name: 'Alex',
    role: 'Customer Relations Representative',
    bio: 'Alex joined B&A Insurance Producers in 2017, bringing a University of Utah degree in financial planning. She supports clients across a wide range of functions — from design work and appointment setting to bookkeeping — ensuring every interaction is professional, warm, and efficient.',
    specialty: 'Client Relations & Operations',
    initial: 'A',
  },
];
---
<Layout
  title="Our Team"
  description="Meet the licensed agents and staff at B&A Insurance Producers in Bountiful, Utah. A dedicated local team with decades of combined experience in personal, business, and health insurance."
>
  <section class="bg-[#016490] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-[#7ebee7] font-semibold text-sm uppercase tracking-widest mb-3">The People Behind B&amp;A</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Meet the Team</h1>
      <p class="text-white/80 text-xl max-w-2xl mx-auto">Real people, local experts, and genuine advocates for your coverage needs.</p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {team.map(({ name, role, bio, specialty, initial }) => (
          <div class="bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-lg transition-shadow overflow-hidden">
            <div class="bg-gradient-to-br from-[#016490] to-[#014d6e] h-36 flex items-center justify-center">
              <div class="w-20 h-20 rounded-full bg-white/20 border-4 border-white/40 flex items-center justify-center text-white text-3xl font-extrabold">
                {initial}
              </div>
            </div>
            <div class="p-6">
              <h2 class="text-xl font-bold text-slate-900">{name}</h2>
              <p class="text-[#016490] font-medium text-sm mt-0.5 mb-1">{role}</p>
              <span class="inline-block bg-[#f4f8fb] text-[#016490] text-xs font-semibold px-2.5 py-1 rounded-full mb-4">{specialty}</span>
              <p class="text-slate-500 text-sm leading-relaxed">{bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#f4f8fb]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">We're Here When You Need Us</h2>
      <p class="text-slate-600 mb-8">Our team is available Monday–Thursday 8:30am–4:30pm and Friday 8:30am–3:00pm. Call or stop by our Bountiful office anytime.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:8014872300" class="px-8 py-4 bg-[#016490] hover:bg-[#014d6e] text-white font-bold rounded-lg transition-colors">(801) 487-2300</a>
        <a href="/contact-us/" class="px-8 py-4 border-2 border-[#016490] text-[#016490] font-semibold rounded-lg hover:bg-white transition-colors">Send a Message</a>
      </div>
    </div>
  </section>
</Layout>
