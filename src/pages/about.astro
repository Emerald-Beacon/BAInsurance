---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---
<Layout
  title="About Us"
  description="Learn the story of B&A Insurance Producers (Bowthorpe & Associates) — a family-owned independent insurance agency in Bountiful, Utah serving clients since the early 1980s."
>
  <!-- Hero -->
  <section class="bg-[#016490] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[#7ebee7] font-semibold text-sm uppercase tracking-widest mb-3">Our Story</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Family Owned.<br />Independently Operated.<br /><span class="text-[#7ebee7]">40+ Years Strong.</span></h1>
      <p class="text-white/80 text-xl max-w-2xl leading-relaxed">We've spent four decades building something rare in insurance: an agency where honesty, options, and personal relationships come before any commission.</p>
    </div>
  </section>

  <!-- Origin Story -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[#016490] font-semibold text-sm uppercase tracking-widest mb-3">Where It Began</p>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Experience Protecting You</h2>
          <div class="w-16 h-1 bg-[#7ebee7] rounded mb-8"></div>
          <p class="text-slate-600 leading-relaxed mb-5">Our founder, Dennis Bowthorpe, started Bowthorpe &amp; Associates in the early 1980s after working as a captive agent for American Hardware Insurance. He quickly found that being confined to a single carrier meant he couldn't always do right by his clients.</p>
          <p class="text-slate-600 leading-relaxed mb-5">So he went independent. As an independent broker, Dennis could offer his clients a genuine choice — comparing multiple insurance solutions to find what actually fit their needs. That customer-first, honesty-above-all approach became the bedrock of everything we do.</p>
          <p class="text-slate-600 leading-relaxed">His daughter Sharie and her spouse George purchased the agency in 2005 and have carried on that tradition with the same integrity and dedication for the past two decades.</p>
        </div>
        <div class="relative rounded-2xl overflow-hidden min-h-[360px]">
          <img
            src="/images/hero/family-photo.jpg"
            alt="Utah family at the beach — the people B&A Insurance protects"
            class="absolute inset-0 w-full h-full object-cover object-center"
            width="640"
            height="360"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-[#016490]/75"></div>
          <div class="relative p-10 text-center flex flex-col items-center justify-center h-full min-h-[360px]">
            <img src="/logo-round.png" alt="B&A Insurance Producers" class="h-20 w-20 mx-auto mb-6" width="80" height="80" />
            <blockquote class="text-white/90 italic text-lg leading-relaxed mb-4">"He found that he liked the option of providing his customers a choice of insurance solutions vs. being confined to one carrier. He has always been customer focused and honest in his approach."</blockquote>
            <p class="text-[#7ebee7] font-semibold text-sm">— Dennis Bowthorpe, Founder</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-[#f4f8fb]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-[#016490] font-semibold text-sm uppercase tracking-widest mb-2">What Drives Us</p>
        <h2 class="text-3xl font-bold text-slate-900">Our Core Values</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: 'lucide:handshake', title: 'Integrity', desc: 'We tell you the truth about coverage — even when a less expensive option isn\'t always the right one.' },
          { icon: 'lucide:unlock', title: 'Independence', desc: 'No carrier loyalty. We represent you, not the insurance company.' },
          { icon: 'lucide:users-round', title: 'Community', desc: 'Bountiful is our home. We\'ve built relationships here for over 40 years.' },
          { icon: 'lucide:phone', title: 'Accessibility', desc: 'When you call, you reach a real agent who knows your name and your policy.' },
        ].map(({ icon, title, desc }) => (
          <div class="bg-white rounded-2xl p-8 text-center shadow-sm border border-slate-100">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-bg)] flex items-center justify-center mb-4 mx-auto">
              <Icon name={icon} class="w-6 h-6 text-[var(--color-brand)]" />
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-3">{title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trusted Choice -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">A Proud "Trusted Choice" Agency</h2>
      <p class="text-slate-600 leading-relaxed mb-8">B&amp;A Insurance Producers is a member of the Trusted Choice® network — independent agents who are committed to providing clients with a choice of policies from multiple companies, customization options, and advocacy on your behalf.</p>
      <a href="/contact-us/" class="inline-block px-10 py-4 bg-[#016490] hover:bg-[#014d6e] text-white font-bold rounded-lg transition-colors shadow">Meet Our Team</a>
    </div>
  </section>
</Layout>
