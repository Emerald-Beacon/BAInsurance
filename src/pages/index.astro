---
import Layout from '../layouts/Layout.astro';
import { Handshake, MapPin, MapPinned, Search, Zap } from '@lucide/astro';

const carriers = [
  { src: '/images/carriers/liberty-mutual.png', alt: 'Liberty Mutual' },
  { src: '/images/carriers/travelers.avif', alt: 'Travelers' },
  { src: '/images/carriers/nationwide.avif', alt: 'Nationwide' },
  { src: '/images/carriers/progressive.avif', alt: 'Progressive' },
  { src: '/images/carriers/safeco.avif', alt: 'Safeco' },
  { src: '/images/carriers/chubb.png', alt: 'Chubb' },
  { src: '/images/carriers/hagerty.avif', alt: 'Hagerty' },
  { src: '/images/carriers/amig.avif', alt: 'American Modern' },
  { src: '/images/carriers/hiscox.avif', alt: 'Hiscox' },
  { src: '/images/carriers/markel.webp', alt: 'Markel' },
  { src: '/images/carriers/aci.avif', alt: 'American Collectors Insurance' },
  { src: '/images/carriers/plm.avif', alt: 'Pennsylvania Lumbermens Mutual' },
  { src: '/images/carriers/old-republic-surety.avif', alt: 'Old Republic Surety' },
  { src: '/images/carriers/rps.avif', alt: 'RPS' },
  { src: '/images/carriers/united-healthcare.avif', alt: 'UnitedHealthcare' },
  { src: '/images/carriers/select-health.avif', alt: 'SelectHealth' },
  { src: '/images/carriers/humana.png', alt: 'Humana' },
  { src: '/images/carriers/aetna.avif', alt: 'Aetna' },
  { src: '/images/carriers/cigna.avif', alt: 'Cigna' },
  { src: '/images/carriers/bcbs-utah.avif', alt: 'Blue Cross Blue Shield of Utah' },
  { src: '/images/carriers/uofu-health.avif', alt: 'University of Utah Health' },
  { src: '/images/carriers/healthcare-gov.avif', alt: 'HealthCare.gov' },
  { src: '/images/carriers/aarp.avif', alt: 'AARP' },
];
---

<Layout
  title="B&A Insurance Producers | Independent Insurance Agency in Bountiful, Utah"
  description="B&A Insurance Producers (Bowthorpe & Associates) is Bountiful, Utah's trusted independent insurance agency. Personal, business, and health insurance from top carriers since the early 1980s. Call (801) 487-2300."
>

  <!-- Hero -->
  <section class="relative min-h-[640px] bg-[#016490] text-white overflow-hidden">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero/utah-mountains-hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/utah-mountains-hero.mp4" type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-[#7ebee7]/20 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#016490]/95 via-[#016490]/80 to-[#7ebee7]/45 pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="min-h-[640px] flex items-center py-24 lg:py-28">
        <div class="max-w-2xl">
          <p class="text-[#7ebee7] font-semibold text-sm uppercase tracking-widest mb-4">Independent · Trusted · Local</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
            Protecting What<br class="hidden sm:block" /> Matters Most<br class="hidden sm:block" />
            <span class="text-[#7ebee7]">to You</span>
          </h1>
          <p class="text-xl text-white/90 mb-8 max-w-xl leading-relaxed">
            As an independent "Trusted Choice" agency, we shop dozens of top carriers to find the right coverage at the right price — for your family, your business, and your health.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact-us/" class="inline-flex items-center justify-center px-8 py-4 bg-white text-[#016490] font-bold rounded-lg hover:bg-[#f4f8fb] transition-colors shadow-lg">
              Get a Free Quote
            </a>
            <a href="tel:8014872300" class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-white/70 text-white font-semibold rounded-lg hover:border-white hover:bg-white/10 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              (801) 487-2300
            </a>
          </div>
          <div class="mt-10 flex flex-wrap gap-6 text-sm text-white/80">
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#7ebee7]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>40+ Years Serving Utah</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#7ebee7]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Multiple Top Carriers</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#7ebee7]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>Family Owned &amp; Operated</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-[#014d6e] text-white py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center items-center gap-x-10 gap-y-2 text-sm font-medium text-white/80 text-center">
        <span class="inline-flex items-center gap-2">
          <MapPin class="w-4 h-4 text-[#7ebee7]" aria-hidden="true" />
          1075 S. 500 W., Ste. 100 &mdash; Bountiful, UT
        </span>
        <span class="hidden sm:block text-white/30">|</span>
        <a href="tel:8014872300" class="hover:text-white">(801) 487-2300</a>
        <span class="hidden sm:block text-white/30">|</span>
        <span>Mon–Thu 8:30am–4:30pm &nbsp;·&nbsp; Fri 8:30am–3:00pm</span>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-[#016490] font-semibold text-sm uppercase tracking-widest mb-2">What We Do</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900">Comprehensive Coverage for Every Stage of Life</h2>
        <p class="mt-4 text-lg text-slate-500 max-w-2xl mx-auto">We represent multiple top-rated carriers so we can match you with the best fit — not just the easiest option.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <a href="/personal/" class="group p-8 rounded-2xl border border-slate-100 hover:border-[#7ebee7] hover:shadow-xl transition-all duration-300 bg-white">
          <div class="w-14 h-14 bg-[#f4f8fb] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#016490] transition-colors">
            <svg class="w-7 h-7 text-[#016490] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#016490] transition-colors">Personal Insurance</h3>
          <p class="text-slate-500 leading-relaxed mb-4">Home, auto, umbrella, motorcycle, boat, RV, and ATV coverage tailored to your lifestyle.</p>
          <span class="text-[#016490] font-semibold text-sm flex items-center gap-1">Explore Personal <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>

        <a href="/business/" class="group p-8 rounded-2xl border border-slate-100 hover:border-[#7ebee7] hover:shadow-xl transition-all duration-300 bg-white">
          <div class="w-14 h-14 bg-[#f4f8fb] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#016490] transition-colors">
            <svg class="w-7 h-7 text-[#016490] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#016490] transition-colors">Business Insurance</h3>
          <p class="text-slate-500 leading-relaxed mb-4">General liability, property, workers comp, professional liability, bonds, and specialty markets.</p>
          <span class="text-[#016490] font-semibold text-sm flex items-center gap-1">Explore Business <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>

        <a href="/health/" class="group p-8 rounded-2xl border border-slate-100 hover:border-[#7ebee7] hover:shadow-xl transition-all duration-300 bg-white">
          <div class="w-14 h-14 bg-[#f4f8fb] rounded-xl flex items-center justify-center mb-6 group-hover:bg-[#016490] transition-colors">
            <svg class="w-7 h-7 text-[#016490] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#016490] transition-colors">Health Insurance</h3>
          <p class="text-slate-500 leading-relaxed mb-4">Individual, group, Medicare Supplement, Medicare Advantage, Part D, and life insurance plans.</p>
          <span class="text-[#016490] font-semibold text-sm flex items-center gap-1">Explore Health <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>

      </div>
    </div>
  </section>

  <!-- Carrier Logo Carousel -->
  <section class="py-14 bg-white border-t border-slate-100" aria-label="Insurance carriers we work with">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold text-slate-400 uppercase tracking-widest mb-8">Carriers We Work With</p>
    </div>
    <div class="logo-marquee" role="presentation">
      <div class="logo-marquee-track">
        {[false, true].map((decorative) => (
          <ul class="logo-marquee-row" aria-hidden={decorative}>
            {carriers.map(({ src, alt }) => (
              <li>
                <img
                  src={src}
                  alt={decorative ? '' : alt}
                  class="h-8 w-auto object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100"
                  width="120"
                  height="32"
                  loading="eager"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 bg-[#f4f8fb]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-[#016490] font-semibold text-sm uppercase tracking-widest mb-2">Why B&amp;A</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">Over 40 Years of Honest,<br />Independent Guidance</h2>
          <p class="text-slate-600 leading-relaxed mb-6">
            Dennis Bowthorpe founded this agency in the early 1980s with a simple belief: clients deserve options, not pressure. As a captive agent, he was limited to one carrier — so he went independent. Today, that same philosophy guides everything we do.
          </p>
          <p class="text-slate-600 leading-relaxed mb-8">
            When Sharie and George took over in 2005, they kept the same customer-centered approach. We're not incentivized to push one carrier over another — we're here to find the best coverage for your specific situation.
          </p>
          <div class="grid grid-cols-2 gap-4">
            {[
              { label: 'Years in Business', value: '40+' },
              { label: 'Insurance Carriers', value: '20+' },
              { label: 'Families Served', value: '1,000s' },
              { label: 'Licensed Agents', value: 'Local' },
            ].map(({ label, value }) => (
              <div class="bg-white rounded-xl p-4 text-center shadow-sm border border-slate-100">
                <div class="text-2xl font-extrabold text-[#016490]">{value}</div>
                <div class="text-sm text-slate-500 mt-1">{label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-1 gap-4">
          {[
            { icon: Search, title: 'We Shop for You', desc: 'Access to dozens of top carriers means we compare so you get the right coverage at the best rate.' },
            { icon: Handshake, title: 'No Carrier Bias', desc: 'As an independent agency, we work for you — not the insurance company. Your interests come first.' },
            { icon: Zap, title: 'Fast, Personal Claims Support', desc: 'When something goes wrong, we\'re on your side helping navigate the claims process quickly.' },
            { icon: MapPinned, title: 'Local Utah Expertise', desc: 'We understand Utah\'s unique risks, regulations, and communities because we\'ve been here for decades.' },
          ].map(({ icon: Icon, title, desc }) => (
            <div class="flex gap-4 bg-white rounded-xl p-5 shadow-sm border border-slate-100">
              <div class="w-11 h-11 rounded-xl bg-[#f4f8fb] border border-slate-100 flex items-center justify-center shrink-0 text-[#016490]">
                <Icon class="w-6 h-6" aria-hidden="true" />
              </div>
              <div>
                <h3 class="font-semibold text-slate-900 mb-1">{title}</h3>
                <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- About Callout -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl overflow-hidden text-white">
        <img
          src="/images/hero/family-photo.jpg"
          alt="Utah family at the beach"
          class="absolute inset-0 w-full h-full object-cover object-center"
          width="1280"
          height="500"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-[#016490]/85"></div>
        <div class="relative p-10 lg:p-16 text-center">
          <img src="/logo-round.png" alt="B&A Insurance Producers badge" class="h-20 w-20 mx-auto mb-6" width="80" height="80" />
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">A Family Agency Built on Trust</h2>
          <p class="text-white/85 text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
            We're not a call center. When you contact B&amp;A, you reach a licensed agent who knows your name, your policy, and your community. That's the difference 40 years of family ownership makes.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/about/" class="px-8 py-4 bg-white text-[#016490] font-bold rounded-lg hover:bg-[#f4f8fb] transition-colors">Our Story</a>
            <a href="/our-team/" class="px-8 py-4 border-2 border-white/60 text-white font-semibold rounded-lg hover:border-white hover:bg-white/10 transition-colors">Meet the Team</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ / SEO Block -->
  <section class="py-20 bg-[#f4f8fb]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="text-[#016490] font-semibold text-sm uppercase tracking-widest mb-2">Common Questions</p>
        <h2 class="text-3xl font-bold text-slate-900">Insurance Questions, Answered</h2>
      </div>
      <div class="space-y-4">
        {[
          { q: 'What is an independent insurance agent?', a: 'An independent agent like B&A Insurance Producers works with multiple insurance carriers, not just one. This means we can compare coverage options and rates from dozens of top companies to find the best fit for your specific needs and budget.' },
          { q: 'Do you serve areas outside of Bountiful, Utah?', a: 'Yes. While our office is in Bountiful, we serve clients throughout Utah including Salt Lake City, Ogden, Provo, and surrounding communities. We can often assist clients remotely by phone and email.' },
          { q: 'How do I get a quote?', a: 'Call us at (801) 487-2300 or use our contact form. One of our licensed agents will gather some basic information and provide you with options from our carrier network — at no cost or obligation.' },
          { q: 'What types of insurance does B&A offer?', a: 'We offer personal insurance (home, auto, umbrella, motorcycle, boat, RV, ATV), business insurance (general liability, property, workers comp, professional liability, bonds), and health insurance (individual plans, group plans, Medicare Supplement, Medicare Advantage, and Part D).' },
          { q: 'What does "Trusted Choice" mean?', a: '"Trusted Choice" is a designation from the Independent Insurance Agents & Brokers of America. It indicates that the agency is independent, represents multiple carriers, and is committed to customer service excellence.' },
        ].map(({ q, a }) => (
          <details class="bg-white rounded-xl border border-slate-100 shadow-sm group">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer font-semibold text-slate-900 list-none">
              {q}
              <svg class="w-5 h-5 text-[#016490] shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="px-6 pb-5 text-slate-600 leading-relaxed border-t border-slate-50 pt-4">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Ready to Review Your Coverage?</h2>
      <p class="text-lg text-slate-500 mb-8">No pressure, no obligation. Just honest guidance from a local agent who cares.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact-us/" class="px-10 py-4 bg-[#016490] hover:bg-[#014d6e] text-white font-bold rounded-lg transition-colors shadow-lg">Get a Free Quote</a>
        <a href="tel:8014872300" class="px-10 py-4 border-2 border-[#016490] text-[#016490] font-semibold rounded-lg hover:bg-[#f4f8fb] transition-colors">Call (801) 487-2300</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .logo-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .logo-marquee-track {
    display: flex;
    width: max-content;
    animation: logo-scroll 70s linear infinite;
    will-change: transform;
  }
  .logo-marquee:hover .logo-marquee-track {
    animation-play-state: paused;
  }
  .logo-marquee-row {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding: 0 2rem;
    list-style: none;
    margin: 0;
  }
  @keyframes logo-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .logo-marquee-track {
      animation: none;
    }
  }
</style>
