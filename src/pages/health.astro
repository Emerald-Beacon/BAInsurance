---
import Layout from '../layouts/Layout.astro';
import { Building2, HeartPulse, Hospital, Pill, Star, User } from '@lucide/astro';

const plans = [
  { icon: User, title: 'Individual Health Plans', desc: 'Marketplace and off-exchange health plans for individuals and families. We help you navigate deductibles, networks, premiums, and subsidies to find a plan that fits your life.' },
  { icon: Building2, title: 'Group Health Insurance', desc: 'Employer-sponsored health coverage for your team. We design plans that attract and retain employees while keeping costs manageable for your business.' },
  { icon: Star, title: 'Medicare Supplement', desc: 'Medigap plans that cover the gaps left by Original Medicare — including deductibles, copays, and coinsurance. We help you compare plans from top carriers.*' },
  { icon: Hospital, title: 'Medicare Advantage', desc: 'All-in-one alternatives to Original Medicare that often include dental, vision, and prescription coverage. Our agents help you compare plans in your area.*' },
  { icon: Pill, title: 'Medicare Part D', desc: 'Prescription drug coverage that works alongside your Medicare plan. We review your medications and help you find the most cost-effective plan.*' },
  { icon: HeartPulse, title: 'Life Insurance', desc: 'Term and permanent life insurance to protect your family\'s financial future. We compare options to match your coverage needs and budget.' },
];

const faqs = [
  { q: 'When can I enroll in health insurance?', a: 'The ACA Open Enrollment Period typically runs November 1 – January 15 for coverage beginning January 1. Outside of open enrollment, you may qualify for a Special Enrollment Period due to life events like losing employer coverage, getting married, or having a baby. Medicare has its own enrollment windows.' },
  { q: 'What\'s the difference between Medicare Advantage and Medicare Supplement?', a: 'Medicare Supplement (Medigap) works alongside Original Medicare and helps cover out-of-pocket costs like deductibles and copays. Medicare Advantage replaces Original Medicare with an all-in-one plan, often including extra benefits like dental and vision. Both have tradeoffs — we\'ll help you choose the right fit.' },
  { q: 'Can B&A help me find a group plan for my small business?', a: 'Yes. We specialize in helping small and mid-sized Utah businesses design competitive group health plans that fit their budget. Offering benefits helps attract and retain employees, and we\'ll walk you through all your options.' },
  { q: 'Is your health guidance free?', a: 'Yes. Our agents are compensated by the insurance carriers — never by the client. You get professional guidance at no cost to you.' },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://bowthorpeinsurance.com/health/#service',
      name: 'Health Insurance',
      serviceType: 'Health insurance: individual and group health plans, Medicare Supplement, Medicare Advantage, Medicare Part D, and life insurance',
      url: 'https://bowthorpeinsurance.com/health/',
      provider: { '@id': 'https://bowthorpeinsurance.com/#agency' },
      areaServed: { '@type': 'State', name: 'Utah' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---
<Layout
  title="Health Insurance"
  description="Health insurance in Bountiful, Utah. B&A Insurance Producers offers individual plans, group plans, Medicare Supplement, Medicare Advantage, Part D, and life insurance. Call (801) 487-2300."
  schema={pageSchema}
>
  <section class="relative bg-[#016490] text-white py-20 overflow-hidden">
    <img
      src="/images/hero/health-header.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
      style="object-position: center 22%;"
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-[#7ebee7]/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#016490]/95 via-[#016490]/80 to-[#7ebee7]/45"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[#7ebee7] font-semibold text-sm uppercase tracking-widest mb-3">Health Coverage</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-6">Health Insurance<br /><span class="text-[#7ebee7]">Plans That Fit Your Needs</span></h1>
      <p class="text-white/80 text-xl max-w-2xl leading-relaxed mb-8">Whether you need an individual plan, group coverage for your business, or help navigating Medicare, our licensed health agents are here to match you with the right carrier.</p>
      <a href="/contact-us/" class="inline-block px-8 py-4 bg-white text-[#016490] font-bold rounded-lg hover:bg-[#f4f8fb] transition-colors shadow-lg">Talk to a Health Agent</a>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold text-slate-900">Health Coverage Options</h2>
        <p class="mt-3 text-slate-500 max-w-xl mx-auto">We take every precaution to match clients with health coverage that truly serves them — not just what's easiest to quote.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="medicare">
        {plans.map(({ icon: Icon, title, desc }) => (
          <div class="bg-[#f4f8fb] rounded-2xl p-8 border border-slate-100 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-white border border-slate-100 flex items-center justify-center mb-4 text-[#016490]">
              <Icon class="w-7 h-7" aria-hidden="true" />
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-3">{title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#016490] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Medicare Can Be Complicated. We Make It Simple.</h2>
        <p class="text-white/80 leading-relaxed mb-6">With multiple Medicare plan types, enrollment windows, and plan-year changes, it's easy to make costly mistakes. Our agents have helped hundreds of Utah seniors navigate their Medicare options — and we never charge for our guidance.</p>
        <p class="text-[#7ebee7] text-sm italic mb-8">*By providing your information for Medicare purposes, you grant permission for a licensed insurance agent to contact you regarding Medicare Supplement, Medicare Advantage, and Prescription Drug Plan options.</p>
        <a href="/contact-us/" class="inline-block px-10 py-4 bg-white text-[#016490] font-bold rounded-lg hover:bg-[#f4f8fb] transition-colors">Talk to a Medicare Specialist</a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 text-center mb-10">Health Insurance FAQs</h2>
      <div class="space-y-4">
        {faqs.map(({ q, a }) => (
          <details class="bg-[#f4f8fb] rounded-xl border border-slate-100 shadow-sm group">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer font-semibold text-slate-900 list-none">
              {q}
              <svg class="w-5 h-5 text-[#016490] shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="px-6 pb-5 text-slate-600 leading-relaxed border-t border-slate-50 pt-4">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Carriers -->
  <section class="py-14 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold text-slate-400 uppercase tracking-widest mb-8">Carriers We Work With</p>
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12">
        <img src="/images/carriers/united-healthcare.avif" alt="UnitedHealthcare" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/select-health.avif" alt="SelectHealth" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/aarp.avif" alt="AARP" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/aetna.avif" alt="Aetna" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/bcbs-utah.avif" alt="BCBS Utah" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
        <img src="/images/carriers/cigna.avif" alt="Cigna" class="h-8 object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100" width="120" height="32" loading="lazy" />
      </div>
    </div>
  </section>
</Layout>
