---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact Us"
  description="Contact B&A Insurance Producers in Bountiful, Utah. Call (801) 487-2300, email info@bowthorpeinsurance.com, or visit us at 1075 S. 500 W., Ste. 100, Bountiful, UT 84010."
>
  <section class="bg-[#016490] text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[#7ebee7] font-semibold text-sm uppercase tracking-widest mb-3">Reach Out</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">We're Ready to Help</h1>
      <p class="text-white/80 text-xl max-w-xl">Calling our number connects you directly with a licensed insurance agent — no bots, no call centers.</p>
    </div>
  </section>

  <section class="py-20 bg-white" id="quote">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">

        <!-- Contact Info -->
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-6">Get in Touch</h2>
            <div class="space-y-5">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-[#f4f8fb] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-[#016490]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <p class="text-xs text-slate-400 uppercase tracking-wide font-semibold mb-0.5">Phone</p>
                  <a href="tel:8014872300" class="text-lg font-semibold text-[#016490] hover:underline">(801) 487-2300</a>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-[#f4f8fb] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-[#016490]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <p class="text-xs text-slate-400 uppercase tracking-wide font-semibold mb-0.5">Email</p>
                  <a href="mailto:info@bowthorpeinsurance.com" class="text-slate-700 hover:text-[#016490]">info@bowthorpeinsurance.com</a>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-[#f4f8fb] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-[#016490]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <p class="text-xs text-slate-400 uppercase tracking-wide font-semibold mb-0.5">Address</p>
                  <address class="not-italic text-slate-700">1075 S. 500 W., Ste. 100<br />Bountiful, UT 84010</address>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-[#f4f8fb] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-[#016490]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                  <p class="text-xs text-slate-400 uppercase tracking-wide font-semibold mb-0.5">Office Hours</p>
                  <p class="text-slate-700 text-sm">Mon–Thu: 8:30am–4:30pm<br />Fri: 8:30am–3:00pm<br />Sat–Sun: Closed</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Map Embed -->
          <div class="rounded-xl overflow-hidden border border-slate-100 shadow-sm h-52">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3020.5!2d-111.8808!3d40.8819!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDDCsDUyJzU0LjgiTiAxMTHCsDUyJzUxLjAiVw!5e0!3m2!1sen!2sus!4v1234567890"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="B&A Insurance Producers office location"
            ></iframe>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <div class="bg-[#f4f8fb] rounded-2xl p-8">
            <h2 class="text-2xl font-bold text-slate-900 mb-2">Request a Quote or Ask a Question</h2>
            <p class="text-slate-500 text-sm mb-6">A licensed agent will follow up within one business day.</p>
            <form
              name="contact"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="space-y-5"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5" for="first-name">First Name *</label>
                  <input type="text" id="first-name" name="first-name" required class="w-full px-4 py-3 border border-slate-200 rounded-lg bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#016490] focus:border-transparent text-sm" placeholder="Jane" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5" for="last-name">Last Name *</label>
                  <input type="text" id="last-name" name="last-name" required class="w-full px-4 py-3 border border-slate-200 rounded-lg bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#016490] focus:border-transparent text-sm" placeholder="Smith" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5" for="email">Email *</label>
                  <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-slate-200 rounded-lg bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#016490] focus:border-transparent text-sm" placeholder="jane@example.com" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-slate-700 mb-1.5" for="phone">Phone</label>
                  <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border border-slate-200 rounded-lg bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#016490] focus:border-transparent text-sm" placeholder="(801) 555-0100" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5" for="coverage-type">Coverage Interest</label>
                <select id="coverage-type" name="coverage-type" class="w-full px-4 py-3 border border-slate-200 rounded-lg bg-white text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#016490] focus:border-transparent text-sm">
                  <option value="">Select a coverage type…</option>
                  <option>Personal (Home, Auto, Umbrella…)</option>
                  <option>Business Insurance</option>
                  <option>Health Insurance</option>
                  <option>Medicare Plans</option>
                  <option>Life Insurance</option>
                  <option>Other / Not Sure</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5" for="message">Message</label>
                <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 border border-slate-200 rounded-lg bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#016490] focus:border-transparent text-sm resize-none" placeholder="Tell us about your coverage needs…"></textarea>
              </div>
              <button type="submit" class="w-full py-4 bg-[#016490] hover:bg-[#014d6e] text-white font-bold rounded-lg transition-colors shadow text-sm">
                Send Message
              </button>
              <p class="text-xs text-slate-400 text-center">By submitting this form, you agree to be contacted by a licensed insurance agent. For Medicare inquiries, you grant permission to discuss Medicare Supplement, Advantage, and Part D options.*</p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
