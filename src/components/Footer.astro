---
const year = new Date().getFullYear();
---

<footer class="bg-[#016490] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <img src="/logo-white.png" alt="B&A Insurance Producers" class="h-24 w-24 mb-4" width="96" height="96" />
        <p class="text-[#7ebee7] text-sm leading-relaxed">
          Independent insurance agency serving Utah families and businesses since the early 1980s.
        </p>
        <p class="mt-4 text-sm text-white/80">
          <strong class="text-white">Trusted Choice</strong> Independent Agent
        </p>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[#7ebee7] mb-4">Our Services</h3>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href="/personal/" class="hover:text-white transition-colors">Personal Insurance</a></li>
          <li><a href="/business/" class="hover:text-white transition-colors">Business Insurance</a></li>
          <li><a href="/health/" class="hover:text-white transition-colors">Health Insurance</a></li>
          <li><a href="/health/#medicare" class="hover:text-white transition-colors">Medicare Plans</a></li>
          <li><a href="/personal/#auto" class="hover:text-white transition-colors">Auto Insurance</a></li>
          <li><a href="/personal/#home" class="hover:text-white transition-colors">Home Insurance</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[#7ebee7] mb-4">Company</h3>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href="/about/" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/our-team/" class="hover:text-white transition-colors">Our Team</a></li>
          <li><a href="/blog/" class="hover:text-white transition-colors">Blog &amp; Resources</a></li>
          <li><a href="/newsletters/" class="hover:text-white transition-colors">Monthly Newsletters</a></li>
          <li><a href="/contact-us/" class="hover:text-white transition-colors">Contact Us</a></li>
          <li><a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-[#7ebee7] mb-4">Contact</h3>
        <ul class="space-y-3 text-sm text-white/80">
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-[#7ebee7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>1075 S. 500 W., Ste. 100<br />Bountiful, UT 84010</span>
          </li>
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-[#7ebee7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <a href="tel:8014872300" class="hover:text-white transition-colors">(801) 487-2300</a>
          </li>
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-[#7ebee7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:info@bowthorpeinsurance.com" class="hover:text-white transition-colors">info@bowthorpeinsurance.com</a>
          </li>
          <li class="flex gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0 text-[#7ebee7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Mon–Thu: 8:30am–4:30pm<br />Fri: 8:30am–3:00pm</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/20 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-white/60">
      <p>&copy; {year} B&amp;A Insurance Producers (Bowthorpe &amp; Associates). All rights reserved.</p>
      <p>Independent "Trusted Choice" Insurance Agency &mdash; Bountiful, Utah</p>
    </div>

    <p class="mt-4 text-xs text-white/40 text-center">
      *By providing your information for Medicare purposes, you grant permission for a licensed insurance agent to contact you regarding Medicare Supplement, Medicare Advantage, and Prescription Drug Plan options.
    </p>
  </div>
</footer>
